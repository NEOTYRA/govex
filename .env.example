# Used by compose.prod.yml. Copy to .env and fill in real values before deploying:
#   cp .env.example .env

# Public domains the proxy requests Let's Encrypt certificates for. Both
# must already point (A/AAAA record) at this server, with ports 80 and 443
# reachable. DOMAIN serves the OIDC flow (issuer, login), ACCOUNT_DOMAIN
# the account management UI - both are the same govex instance.
DOMAIN=auth.example.com
ACCOUNT_DOMAIN=account.example.com

# Parent domain of DOMAIN and ACCOUNT_DOMAIN, so the govex session and the
# Anubis challenge cookie are shared between both.
COOKIE_DOMAIN=example.com

# Email Let's Encrypt uses for renewal/expiry notices.
ACME_EMAIL=admin@example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Generate with: openssl genrsa 4096
# Wrap the PEM contents in double quotes - .env files support multi-line
# values this way, but NOT unquoted (docker compose fails to parse it then).
OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
change-me
-----END PRIVATE KEY-----"

DB_NAME=govex
DB_USER=govex
DB_PASSWORD=change-me

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Registers product (or any other first-party client app) as a trusted
# OAuth2/OIDC client on startup. Leave blank to skip registration.
# Generate CLIENT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(50))"
CLIENT_NAME=examplename
CLIENT_ID=examplename
CLIENT_SECRET=change-me
CLIENT_REDIRECT_URI=https://product.ch/api/auth/oidc/callback/
