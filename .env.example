# Used by compose.prod.yml. Copy to .env and fill in real values before deploying:
#   cp .env.example .env

# Public domains the proxy requests Let's Encrypt certificates for. Both
# must already point (A/AAAA record) at this server, with ports 80 and 443
# reachable.
DOMAIN=auth.example.com
ACCOUNT_DOMAIN=account.example.com

COOKIE_DOMAIN=example.com

# Email Let's Encrypt uses for renewal/expiry notices.
ACME_EMAIL=admin@example.com

ADMIN_IPS=203.0.113.7/32

AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_DB_PASSWORD=change-me

AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me

WINTERSEHN_CLIENT_ID=wintersehn
WINTERSEHN_CLIENT_SECRET=change-me
WINTERSEHN_REDIRECT_URI=https://wintersehn.ch/api/auth/oidc/callback/
WINTERSEHN_LAUNCH_URL=https://wintersehn.ch/
WINTERSEHN_ACCOUNT_DELETED_URL=https://wintersehn.ch/api/auth/oidc/account-deleted/
WINTERSEHN_ACCOUNT_UPDATED_URL=https://wintersehn.ch/api/auth/oidc/account-updated/

CAPTCHA_PUBLIC_KEY=
CAPTCHA_PRIVATE_KEY=

SESSION_NETWORK_BINDING=no_binding
SESSION_GEOIP_BINDING=bind_continent

AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__FROM=

GOVEX_MIGRATION_TOKEN=
# Public key of wintersehn's consent signing key (manage.py consent_signing_key
# there), one line with \n for line breaks.
WINTERSEHN_CONSENT_KEY=

DJANGO_SECRET_KEY=change-me
DB_NAME=govex
DB_USER=govex
DB_PASSWORD=change-me
