#!/usr/bin/env bash
# Usage: ./deploy (run from the same directory as compose.prod.yml,
# e.g. /opt/govex on the server)
set -euo pipefail

cd "$(dirname "$0")"

COMPOSE_FILE="compose.prod.yml"
COMPOSE=(docker compose -f "$COMPOSE_FILE")

if [[ ! -f "$COMPOSE_FILE" ]]; then
  echo "error: $COMPOSE_FILE not found in $(pwd)." >&2
  exit 1
fi

echo "==> Pulling latest images"
"${COMPOSE[@]}" pull

echo "==> Starting / recreating services"
"${COMPOSE[@]}" up -d --remove-orphans --wait

echo "==> Done."
"${COMPOSE[@]}" ps
