#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <username> \"<reason>\"" >&2
  exit 1
fi

if [[ -f compose.prod.yml ]]; then
  COMPOSE_FILE="compose.prod.yml"
else
  COMPOSE_FILE="../compose.yml"
fi

docker compose -f "$COMPOSE_FILE" exec -T \
  -e LOCKDOWN_USERNAME="$1" -e LOCKDOWN_REASON="$2" \
  authentik-worker ak shell -c '
import os
from authentik.core.models import User
exec(open("/blueprints/govex/lockdown.py").read())
user = User.objects.get(username=os.environ["LOCKDOWN_USERNAME"])
lockdown(user, os.environ["LOCKDOWN_REASON"])
print(f"Locked down {user.username} ({user.uuid}).")
'
