# Trust X-Forwarded-* from the edge proxy and Anubis in front of this
# container (both on the private Docker network). Without this, Caddy
# replaces X-Forwarded-Proto with "http" - the scheme of its own hop.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip

	@govex_ui path /if/flow/* /if/user/*

	@authentik path /api/v3/* /application/* /flows/* /if/* /static/* /media/* /ws/* /-/*

	header @spa Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	@spa not path /api/v3/* /application/* /flows/* /if/admin/* /static/* /media/* /ws/* /-/*

	header @authentik_ui Content-Security-Policy "default-src 'self'; img-src https: data:; object-src 'none'; frame-ancestors 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
	@authentik_ui path /api/v3/* /application/* /flows/* /if/admin/* /static/* /ws/* /-/*

	handle @govex_ui {
		root * /srv
		rewrite * /index.html
		file_server
	}

	handle @authentik {
		reverse_proxy authentik-server:9000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
