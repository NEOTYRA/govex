# Trust X-Forwarded-* from the edge proxy and Anubis in front of this
# container (both on the private Docker network). Without this, Caddy
# replaces X-Forwarded-Proto with "http" - the scheme of its own hop -
# and Django (plus the OIDC issuer it advertises) thinks every request
# is plain HTTP.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /o/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /django-admin/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle /static/* {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			health_uri /api/health/
			health_interval 1s
			health_timeout 1s
			lb_try_duration 3s
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
